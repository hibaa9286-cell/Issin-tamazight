// Prisma Schema for AGY-AMAZIGH Unified Digital Platform
// Covers Dictionary, LMS, Museum, and Collaborative Portal

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// CORE & USER ROLES
// -------------------------------------------------------------
enum Role {
  STUDENT
  TEACHER
  PARENT
  LINGUIST_EXPERT
  MUSEUM_CURATOR
  ADMIN
}

enum EducationLevel {
  PRIMARY
  MIDDLE
  SECONDARY
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          Role            @default(STUDENT)
  level         EducationLevel? @default(PRIMARY)
  wilaya        String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  gamification  GamificationProfile?
  enrolledCourses CourseEnrollment[]
  contributions TeacherContribution[]
  posts         CulturalForumPost[]
  standardizationProposals StandardTermProposal[]
}

// -------------------------------------------------------------
// 1. LINGUISTIC ENGINEERING & SMART DICTIONARY
// -------------------------------------------------------------
model DictionaryEntry {
  id                String   @id @default(uuid())
  tifinagh          String
  latinTamaziɣt     String
  arabicMeaning     String
  frenchMeaning     String?
  root              String?
  partOfSpeech      String
  isLexicalCommon   Boolean  @default(false)
  isStandardized    Boolean  @default(false)
  standardCategory  String?
  audioUrl          String?
  createdAt         DateTime @default(now())

  variants          DialectVariant[]
  commonBadges      LexicalCommonBadge[]
}

model DialectVariant {
  id                String   @id @default(uuid())
  dictionaryEntryId String
  dictionaryEntry   DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id], onDelete: Cascade)
  
  dialectCode       String
  dialectName       String
  region            String
  localSpelling     String
  audioPronunciation String?
  usageNotes        String?
}

model LexicalCommonBadge {
  id                String   @id @default(uuid())
  dictionaryEntryId String
  dictionaryEntry   DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id], onDelete: Cascade)
  regionCode        String
  regionName        String
}

model StandardTermProposal {
  id            String   @id @default(uuid())
  proposedByUserId String
  proposedBy    User     @relation(fields: [proposedByUserId], references: [id])
  termLatin     String
  termTifinagh  String
  arabicMeaning String
  domain        String
  justification String
  status        String   @default("PENDING")
  linguistVotes Int      @default(0)
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// 2. PEDAGOGICAL ENGINEERING & LMS
// -------------------------------------------------------------
model Course {
  id            String         @id @default(uuid())
  title         String
  description   String
  level         EducationLevel
  gradeYear     Int
  curriculumCode String
  icon          String?
  createdAt     DateTime       @default(now())

  modules       CourseModule[]
  enrollments   CourseEnrollment[]
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Int
  lessons     Lesson[]
}

model Lesson {
  id            String       @id @default(uuid())
  moduleId      String
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  contentType   String
  contentData   Json
  xpReward      Int          @default(50)
  orderIndex    Int
}

model GamificationProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp            Int      @default(0)
  streakDays    Int      @default(1)
  lastActive    DateTime @default(now())
  badges        String
  avatarCustom  Json?
}

model CourseEnrollment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPct Float    @default(0.0)
  completedAt DateTime?
}

// -------------------------------------------------------------
// 3. DIGITAL MUSEUM & CULTURAL HERITAGE
// -------------------------------------------------------------
model MuseumExhibit {
  id          String   @id @default(uuid())
  title       String
  period      String
  region      String
  description String
  mediaType   String
  mediaUrl    String
  thumbnailUrl String?
  mapLat      Float?
  mapLng      Float?
  historicalContext String
}

// -------------------------------------------------------------
// 4. COLLABORATIVE & NATIONAL TALENT PORTAL
// -------------------------------------------------------------
model TeacherContribution {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  targetLevel EducationLevel
  wilaya      String
  contentUrl  String
  summary     String
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
}

model CulturalForumPost {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  wilayaOrigin String
  category    String
  content     String
  likesCount  Int      @default(0)
  createdAt   DateTime @default(now())
}
